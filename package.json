{
  "name": "srcdev-nuxt-i18n",
  "version": "0.2.0",
  "type": "module",
  "main": "nuxt.config.ts",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "files": [
    ".claude/skills/",
    "components",
    "composables",
    "i18n",
    "scripts",
    "nuxt.config.ts",
    "!**/tests/"
  ],
  "scripts": {
    "build": "npm run build:i18n && nuxt build",
    "build:i18n": "node scripts/build-i18n.mjs",
    "build:i18n:watch": "node scripts/build-i18n.mjs --watch",
    "dev": "concurrently \"npm run build:i18n:watch\" \"nuxt dev\" --names \"i18n,nuxt\" --prefix-colors \"cyan,green\"",
    "prepare": "nuxt prepare",
    "release": "release-it",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "test:update": "vitest --update"
  },
  "dependencies": {
    "@nuxtjs/i18n": "10.6.0",
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "@nuxt/test-utils": "4.4.0",
    "@types/node": "24.19.2",
    "@vue/test-utils": "2.5.1",
    "concurrently": "10.0.7",
    "happy-dom": "21.0.4",
    "nuxt": "4.6.4",
    "release-it": "21.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "nuxt": "^4.6.0"
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it/schema/release-it.json",
    "git": {
      "commitMessage": "chore(release): release v${version}"
    },
    "github": {
      "release": true,
      "releaseName": "v${version}"
    }
  },
  "overrides": {
    "vite": "8.3.8"
  }
}
