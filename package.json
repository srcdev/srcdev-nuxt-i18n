{
  "name": "srcdev-nuxt-i18n",
  "version": "0.1.0",
  "type": "module",
  "main": "nuxt.config.ts",
  "license": "MIT",
  "files": [
    ".claude/",
    "components",
    "composables",
    "i18n",
    "scripts",
    "nuxt.config.ts"
  ],
  "scripts": {
    "build": "npm run build:i18n && nuxt build",
    "build:i18n": "node scripts/build-i18n.mjs",
    "build:i18n:watch": "node scripts/build-i18n.mjs --watch",
    "dev": "concurrently \"npm run build:i18n:watch\" \"nuxt dev\" --names \"i18n,nuxt\" --prefix-colors \"cyan,green\"",
    "prepare": "nuxt prepare",
    "release": "release-it",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "test:update": "vitest --update"
  },
  "dependencies": {
    "@nuxtjs/i18n": "10.2.1",
    "markdown-it": "14.1.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "3.23.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.0.0",
    "@vue/test-utils": "2.4.10",
    "concurrently": "9.1.2",
    "happy-dom": "20.9.0",
    "nuxt": "4.3.0",
    "release-it": "20.0.1",
    "typescript": "5.8.3",
    "vite": "8.1.4",
    "vitest": "3.2.4"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it/schema/release-it.json",
    "git": {
      "commitMessage": "chore(release): release v${version}"
    },
    "github": {
      "release": true,
      "releaseName": "v${version}"
    }
  }
}
